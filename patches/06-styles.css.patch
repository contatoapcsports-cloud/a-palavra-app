diff --git a/styles.css b/styles.css
index a53f6ed..5414ba3 100644
--- a/styles.css
+++ b/styles.css
@@ -244,3 +244,22 @@ a.srow{color:inherit;text-decoration:none}
 .listen select{min-height:44px;border-radius:12px;padding:0 10px;background:rgba(255,255,255,.07);color:inherit;border:1px solid rgba(255,255,255,.2);max-width:100%}
 .listen small{color:var(--soft);font-size:12px;flex-basis:100%}
 .v.lendo{background:rgba(212,175,90,.18);border-radius:10px}
+
+/* tradução bíblica: barra na leitura, crédito sob o texto e seletor */
+.verbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:2px 0 8px}
+.verbar .vname{font-size:13px;color:var(--soft);line-height:1.35}
+.verbar .vname b{color:var(--text)}
+.verbar button{font-size:13px;font-weight:700;padding:8px 14px;border-radius:14px;background:var(--card-2);color:var(--text);min-height:40px}
+.vaviso{font-size:12.5px;line-height:1.45;padding:10px 12px;border-radius:14px;background:var(--gold-soft);color:var(--tagink);margin:0 0 8px}
+.vcred{font-size:11.5px;line-height:1.5;color:var(--soft);margin:10px 2px 0}
+.vcred button{font-size:11.5px;font-weight:700;text-decoration:underline;color:var(--accent);padding:2px 0}
+.vopt{display:block;width:100%;text-align:left;padding:14px 16px;border-radius:18px;background:var(--card);box-shadow:var(--shadow);margin:0 0 10px;color:var(--text)}
+.vopt[aria-pressed="true"]{outline:2px solid var(--accent)}
+.vopt strong{display:block;font-size:16px}
+.vopt .vsub{display:block;font-size:12.5px;color:var(--soft);margin-top:2px;line-height:1.4}
+.vopt .vbadge{display:inline-block;font-size:11px;font-weight:700;padding:2px 9px;border-radius:10px;background:var(--gold-soft);color:var(--tagink);margin-top:6px}
+.vdl{display:block;width:100%;margin:-4px 0 12px;padding:10px 14px;border-radius:14px;background:var(--card-2);color:var(--text);font-size:13px;font-weight:700;min-height:44px}
+
+.vsearch{width:100%;box-sizing:border-box;padding:12px 14px;border-radius:14px;border:1px solid var(--line,#ccc);background:var(--card);color:var(--text);font-size:16px;margin:0 0 12px}
+.vgrp{font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:var(--soft);margin:14px 2px 8px}
+.ptitulo{font-style:italic;color:var(--soft);margin:0 0 12px;line-height:1.5}
